  "info": {
    "title": "ShopStream Public API",
    "description": "Публичный API ShopStream: каталог услуг, баланс, заказы «Живой чат» и «Комментарии» (Telegram). Аутентификация по заголовку x-api-key. Ключ выпускает администратор. Успешные ответы обёрнуты в конверт { success, data }. Ошибки приходят в формате { error, url, statusCode, statusMessage, message, data? }. Версия API — в пути: базовый URL https://shop-stream.ru/api/v1.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "https://shop-stream.ru/api/v1",
      "description": "Production"
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "PublicServiceListDto": {
        "type": "object",
        "properties": {
          "services": {
            "type": "array",
            "description": "Услуги, доступные владельцу ключа. Форма элемента зависит от type: Chat — с levels, Comment — с subscriptions",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/PublicChatServiceDto"
                },
                {
                  "$ref": "#/components/schemas/PublicCommentServiceDto"
                }
              ],
              "discriminator": {
                "propertyName": "type",
                "mapping": {
                  "Chat": "#/components/schemas/PublicChatServiceDto",
                  "Comment": "#/components/schemas/PublicCommentServiceDto"
                }
              }
            }
          }
        },
        "required": ["services"]
      },
      "PublicBalanceDto": {
        "type": "object",
        "properties": {
          "balance": {
            "type": "string",
            "description": "Текущий баланс владельца ключа (строка-Decimal, рубли)",
            "example": "1530.50"
          }
        },
        "required": ["balance"]
      },
      "PublicCreateChatOrderDto": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": ["Twitch", "Kick", "Youtube", "Wtv", "Vkplay"],
            "description": "Площадка стрима",
            "example": "Twitch"
          },
          "channelUrl": {
            "type": "string",
            "minLength": 1,
            "description": "Название канала или ссылка на канал выбранной площадки. Для YouTube допускается и ссылка на видео или трансляцию (watch, live, shorts, youtu.be): канал определяется по автору видео. Сервер приводит значение к каноничной ссылке канала, например @MrBeast → https://youtube.com/@MrBeast",
            "example": "https://twitch.tv/somechannel",
            "maxLength": 300
          },
          "startAt": {
            "type": "string",
            "format": "date-time",
            "description": "Время старта чата, ISO 8601 с зоной: Z или смещение (например +03:00). Сервер сам переводит в московское время",
            "example": "2026-07-01T18:00:00Z"
          },
          "durationMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440,
            "description": "Длительность чата в минутах (1..1440)",
            "example": 60
          },
          "level": {
            "default": 1,
            "description": "Уровень заказа 1 (по умолчанию), 2 или 3: 2 и 3 стоят дороже (доплата за площадку в GET /services)",
            "example": 1,
            "anyOf": [
              {
                "type": "number",
                "enum": [1]
              },
              {
                "type": "number",
                "enum": [2]
              },
              {
                "type": "number",
                "enum": [3]
              }
            ]
          },
          "language": {
            "description": "Язык сообщений (по умолчанию «Русский»)",
            "example": "Русский",
            "type": "string",
            "maxLength": 50
          },
          "comment": {
            "description": "Произвольный комментарий к заказу",
            "example": "Поддержка стрима",
            "type": "string",
            "maxLength": 500
          }
        },
