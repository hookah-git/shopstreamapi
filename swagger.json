        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/PublicServiceListDto"
                    },
                    "ts": {
                      "type": "string",
                      "nullable": true,
                      "example": "42ms"
                    },
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": ["success", "data", "ts", "id"]
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "errors": {
                      "oneOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        {
                          "type": "object"
                        }
                      ]
                    },
                    "ts": {
                      "type": "string",
                      "nullable": true,
                      "example": "42ms"
                    },
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": ["success", "errors", "ts", "id"]
                }
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Список доступных услуг",
        "tags": ["Public API"]
      }
    },
