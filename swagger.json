{
  "openapi": "3.0.0",
  "paths": {
    "/services": {
      "get": {
        "description": "Возвращает услуги, доступные владельцу ключа; форма элемента зависит от type. Chat («Живой чат», по видимым площадкам): cost.price — цена за час чата 1 уровня на русском языке с учётом всех скидок владельца ключа; для иностранного языка базовая цена ×2; доплата за уровни 2 и 3 (levels) добавляется к итогу заказа отдельно. Comment («Комментарии», Telegram): cost.price — цена одного поста с учётом всех скидок; subscriptions — цены подписок (только для вывода: оформить подписку через API нельзя).",
        "operationId": "listServices",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/PublicServiceListDto"
                    }
                  },
                  "required": ["success", "data"]
                },
                "examples": {
                  "chatAndComments": {
                    "summary": "Чат и комментарии",
                    "value": {
                      "success": true,
                      "data": {
                        "services": [
                          {
                            "id": 12,
                            "platform": "Twitch",
                            "type": "Chat",
                            "cost": {
                              "price": 56
                            },
                            "levels": [
                              {
                                "level": 1,
                                "surcharge": 0
                              },
                              {
                                "level": 2,
                                "surcharge": 50
                              },
                              {
                                "level": 3,
                                "surcharge": 120
                              }
                            ]
                          },
                          {
                            "id": 7,
                            "platform": "Telegram",
                            "type": "Comment",
                            "cost": {
                              "price": 30
                            },
                            "subscriptions": [
                              {
                                "id": 3,
                                "quantity": 5,
                                "durationHours": 720,
                                "price": 900
                              }
                            ]
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Нет ключа, ключ недействителен или истёк",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "Пользователь заблокирован",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          },
          "429": {
            "description": "Превышен лимит запросов (60 в минуту на ключ)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          },
          "502": {
            "description": "Сервис заказов недоступен или вернул ошибку",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Список доступных услуг",
        "tags": ["Public API"]
      }
    },
