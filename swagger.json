    "/orders/{id}": {
      "get": {
        "description": "Свой заказ по id; чужой и несуществующий неразличимы (404). Форма ответа зависит от type заказа: Chat, Comment или другой тип, оформленный на сайте. Статусы удобнее получать не опросом, а через callback: адрес настраивается для ключа в panel/settings (раздел «Callback (webhook)»).",
        "operationId": "getOrder",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/PublicChatOrderDto"
                        },
                        {
                          "$ref": "#/components/schemas/PublicCommentOrderDto"
                        },
                        {
                          "$ref": "#/components/schemas/PublicOtherOrderDto"
                        }
                      ],
                      "discriminator": {
                        "propertyName": "type",
                        "mapping": {
                          "Chat": "#/components/schemas/PublicChatOrderDto",
                          "Comment": "#/components/schemas/PublicCommentOrderDto",
                          "Follow": "#/components/schemas/PublicOtherOrderDto",
                          "Viewer": "#/components/schemas/PublicOtherOrderDto",
                          "View": "#/components/schemas/PublicOtherOrderDto"
                        }
                      }
                    }
                  },
                  "required": ["success", "data"]
                },
                "examples": {
                  "chat": {
                    "summary": "Заказ «Живой чат»",
                    "value": {
                      "success": true,
                      "data": {
                        "id": "3f1a9c2e-4b7d-4a10-9c1e-2b6f5a8d0e11",
                        "platform": "Twitch",
                        "type": "Chat",
                        "status": "Searching",
                        "params": {
                          "channelUrl": "https://twitch.tv/somechannel",
                          "startAt": "2026-07-01T18:00:00.000Z",
                          "durationMinutes": 60,
                          "language": "Русский",
                          "comment": "Поддержка стрима",
                          "level": 1
                        },
                        "amount": "56.00",
                        "createdAt": "2026-06-23T12:34:56.000Z",
                        "updatedAt": "2026-06-23T12:34:56.000Z"
                      }
                    }
                  },
                  "commentPublished": {
                    "summary": "Заказ «Комментарии», пост уже вышел",
                    "value": {
                      "success": true,
                      "data": {
                        "id": "6b1c7d2e-8a3f-4c55-b0a1-9d4e2f7a1c30",
                        "platform": "Telegram",
                        "type": "Comment",
                        "status": "InProgress",
                        "params": {
                          "alreadyPublished": true,
                          "postUrl": "https://t.me/channel/123",
                          "comment": "Поддержка поста"
                        },
                        "amount": "30.00",
                        "createdAt": "2026-06-23T12:34:56.000Z",
                        "updatedAt": "2026-06-23T12:34:56.000Z"
                      }
                    }
                  },
                  "commentScheduled": {
                    "summary": "Заказ «Комментарии», пост запланирован",
                    "value": {
                      "success": true,
                      "data": {
                        "id": "9e2a4c61-3b7d-4f08-a6c2-1d5b8e0f7a42",
                        "platform": "Telegram",
                        "type": "Comment",
                        "status": "InProgress",
                        "params": {
                          "alreadyPublished": false,
                          "channelUrl": "https://t.me/channel",
                          "startAt": "2026-07-01T18:00:00.000Z",
                          "comment": "Поддержка поста"
                        },
                        "amount": "30.00",
                        "createdAt": "2026-06-23T12:34:56.000Z",
                        "updatedAt": "2026-06-23T12:34:56.000Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Некорректный id заказа (не UUID)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "Нет ключа, ключ недействителен или истёк",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
