{
  "openapi": "3.0.0",
  "paths": {
    "/services": {
      "get": {
        "description": "Возвращает тарифы услуги «Живой чат» по видимым площадкам. Поле cost.price — цена за час чата 1 уровня на русском языке для владельца ключа с учётом всех его скидок. Для иностранного языка базовая цена ×2, доплата за уровни 2 и 3 добавляется к итогу заказа отдельно.",
        "operationId": "listServices",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/PublicServiceListDto"
                    }
                  },
                  "required": ["success", "data"]
                }
              }
            }
          },
          "401": {
            "description": "Нет ключа, ключ недействителен или истёк",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "Пользователь заблокирован",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          },
          "429": {
            "description": "Превышен лимит запросов (60 в минуту на ключ)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          },
          "502": {
            "description": "Сервис заказов недоступен или вернул ошибку",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Список доступных услуг",
        "tags": ["Public API"]
      }
    },
    "/balance": {
      "get": {
        "description": "Возвращает текущий баланс пользователя, которому принадлежит API-ключ.",
        "operationId": "getBalance",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/PublicBalanceDto"
                    }
                  },
                  "required": ["success", "data"]
                }
              }
            }
          },
          "401": {
            "description": "Нет ключа, ключ недействителен или истёк",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "Пользователь заблокирован",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          },
          "429": {
            "description": "Превышен лимит запросов (60 в минуту на ключ)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          },
          "502": {
            "description": "Сервис заказов недоступен или вернул ошибку",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Баланс владельца ключа",
        "tags": ["Public API"]
      }
    },
    "/orders": {
      "post": {
        "description": "Оформляет заказ на живой чат для стрима. В тестовом режиме поддерживается только тип Chat. Сумма рассчитывается сервером по тарифу услуги и списывается с баланса владельца ключа; указывать сумму не нужно. Время старта startAt трактуется как UTC.",
        "operationId": "createChatOrder",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublicCreateChatOrderDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/PublicOrderDto"
                    }
                  },
                  "required": ["success", "data"]
                }
              }
            }
          },
          "400": {
            "description": "Ошибка валидации запроса",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "Нет ключа, ключ недействителен или истёк",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "Пользователь заблокирован",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          },
          "409": {
            "description": "Бизнес-ограничение, например недостаточно средств (insufficient balance)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          },
          "429": {
            "description": "Превышен лимит запросов (60 в минуту на ключ)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          },
          "502": {
            "description": "Сервис заказов недоступен или вернул ошибку",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Создать заказ «Живой чат»",
        "tags": ["Public API"]
      }
    },
    "/orders/{id}": {
      "get": {
        "description": "Возвращает заказ, оформленный владельцем ключа. Чужой или несуществующий заказ → 404.",
        "operationId": "getOrder",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/PublicOrderDto"
                    }
                  },
                  "required": ["success", "data"]
                }
              }
            }
          },
          "400": {
            "description": "Некорректный id заказа (не UUID)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "Нет ключа, ключ недействителен или истёк",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "Пользователь заблокирован",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "Заказ не найден (чужой и несуществующий неразличимы)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          },
          "429": {
            "description": "Превышен лимит запросов (60 в минуту на ключ)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          },
          "502": {
            "description": "Сервис заказов недоступен или вернул ошибку",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Получить свой заказ по id",
        "tags": ["Public API"]
      }
    }
  },
  "info": {
    "title": "ShopStream Public API",
    "description": "Публичный API ShopStream. Аутентификация по заголовку x-api-key. Ключ выпускает администратор. Успешные ответы обёрнуты в конверт { success, data }. Ошибки приходят в формате { error, url, statusCode, statusMessage, message, data? }. Версия API — в пути: базовый URL https://shop-stream.ru/api/v1.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "https://shop-stream.ru/api/v1",
      "description": "Production"
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "PublicServiceListDto": {
        "type": "object",
        "properties": {
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Идентификатор услуги",
                  "example": 12
                },
                "platform": {
                  "type": "string",
                  "enum": ["Twitch", "Kick", "Youtube", "Wtv", "Vkplay"],
                  "description": "Площадка",
                  "example": "Twitch"
                },
                "type": {
                  "type": "string",
                  "enum": ["Chat"],
                  "description": "Тип услуги (сейчас в API только «Живой чат»)",
                  "example": "Chat"
                },
                "cost": {
                  "type": "object",
                  "properties": {
                    "price": {
                      "type": "number"
                    }
                  },
                  "required": ["price"],
                  "description": "Тариф: price — цена часа чата на русском с учётом всех скидок пользователя (рубли). Для другого языка цена ×2",
                  "example": {
                    "price": 56
                  }
                },
                "levels": {
                  "type": "array",
                  "description": "Доплата к итогу заказа за уровень (1, 2, 3), добавляется после скидок. У уровня 1 доплаты нет",
                  "items": {
                    "type": "object",
                    "properties": {
                      "level": {
                        "type": "integer",
                        "enum": [1, 2, 3],
                        "example": 2
                      },
                      "surcharge": {
                        "type": "number",
                        "description": "Доплата, рубли",
                        "example": 50
                      }
                    },
                    "required": ["level", "surcharge"]
                  }
                }
              },
              "required": ["id", "platform", "type", "cost", "levels"]
            }
          }
        },
        "required": ["services"]
      },
      "PublicBalanceDto": {
        "type": "object",
        "properties": {
          "balance": {
            "type": "string",
            "description": "Текущий баланс владельца ключа (строка-Decimal, рубли)",
            "example": "1530.50"
          }
        },
        "required": ["balance"]
      },
      "PublicOrderDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Идентификатор заказа",
            "example": "3f1a9c2e-4b7d-4a10-9c1e-2b6f5a8d0e11"
          },
          "platform": {
            "type": "string",
            "enum": ["Twitch", "Kick", "Youtube", "Wtv", "Vkplay", "Telegram"],
            "example": "Twitch"
          },
          "type": {
            "type": "string",
            "enum": ["Follow", "Chat", "Viewer", "Comment", "View"],
            "example": "Chat"
          },
          "status": {
            "type": "string",
            "enum": [
              "Searching",
              "Accepted",
              "InProgress",
              "Paused",
              "Cancelled",
              "Completed"
            ],
            "description": "Текущий статус заказа",
            "example": "Searching"
          },
          "params": {
            "type": "object",
            "additionalProperties": true,
            "description": "Параметры заказа. Для типа Chat — в той же форме, что принимает POST /orders. Для остальных типов — как сохранены в заказе",
            "properties": {
              "channelUrl": {
                "type": "string",
                "description": "Ссылка на канал/стрим",
                "example": "https://twitch.tv/somechannel"
              },
              "startAt": {
                "type": "string",
                "nullable": true,
                "format": "date-time",
                "description": "Время старта, ISO 8601 (UTC)",
                "example": "2026-07-01T18:00:00.000Z"
              },
              "durationMinutes": {
                "type": "integer",
                "description": "Длительность в минутах",
                "example": 60
              },
              "language": {
                "type": "string",
                "description": "Язык сообщений",
                "example": "Русский"
              },
              "comment": {
                "type": "string",
                "description": "Комментарий к заказу",
                "example": "Поддержка стрима"
              },
              "level": {
                "type": "integer",
                "enum": [1, 2, 3],
                "description": "Уровень заказа (1, 2 или 3)",
                "example": 1
              }
            }
          },
          "amount": {
            "type": "string",
            "description": "Списанная сумма (строка-Decimal, рубли)",
            "example": "56.00"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
            "example": "2026-06-23T12:34:56.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
            "example": "2026-06-23T12:34:56.000Z"
          }
        },
        "required": [
          "id",
          "platform",
          "type",
          "status",
          "params",
          "amount",
          "createdAt",
          "updatedAt"
        ]
      },
      "PublicCreateChatOrderDto": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": ["Twitch", "Kick", "Youtube", "Wtv", "Vkplay"],
            "description": "Площадка стрима",
            "example": "Twitch"
          },
          "channelUrl": {
            "type": "string",
            "minLength": 1,
            "description": "Ссылка на канал/стрим",
            "example": "https://twitch.tv/somechannel",
            "maxLength": 300
          },
          "startAt": {
            "type": "string",
            "format": "date-time",
            "description": "Время старта чата, ISO 8601 с зоной: Z или смещение (например +03:00). Сервер сам переводит в московское время",
            "example": "2026-07-01T18:00:00Z"
          },
          "durationMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440,
            "description": "Длительность чата в минутах (1..1440)",
            "example": 60
          },
          "level": {
            "default": 1,
            "description": "Уровень заказа 1 (по умолчанию), 2 или 3: 2 и 3 стоят дороже (доплата за площадку в GET /services)",
            "example": 1,
            "anyOf": [
              {
                "type": "number",
                "enum": [1]
              },
              {
                "type": "number",
                "enum": [2]
              },
              {
                "type": "number",
                "enum": [3]
              }
            ]
          },
          "language": {
            "description": "Язык сообщений (по умолчанию «Русский»)",
            "example": "Русский",
            "type": "string",
            "maxLength": 50
          },
          "comment": {
            "description": "Произвольный комментарий к заказу",
            "example": "Поддержка стрима",
            "type": "string",
            "maxLength": 500
          }
        },
        "required": ["platform", "channelUrl", "startAt", "durationMinutes"]
      },
      "PublicErrorDto": {
        "type": "object",
        "properties": {
          "error": {
            "type": "boolean",
            "example": true
          },
          "url": {
            "type": "string",
            "description": "Полный URL запроса",
            "example": "https://shop-stream.ru/api/v1/orders"
          },
          "statusCode": {
            "type": "integer",
            "description": "HTTP-статус",
            "example": 409
          },
          "statusMessage": {
            "type": "string",
            "description": "Краткая причина отказа",
            "example": "insufficient balance"
          },
          "message": {
            "type": "string",
            "description": "То же, что statusMessage",
            "example": "insufficient balance"
          },
          "data": {
            "type": "object",
            "description": "Дополнительные данные (необязательно)",
            "properties": {
              "code": {
                "type": "string",
                "description": "Стабильный код ошибки заказа, если известен",
                "example": "free_test_used_chat"
              }
            }
          }
        },
        "required": ["error", "url", "statusCode", "statusMessage", "message"]
      }
    }
  }
}
